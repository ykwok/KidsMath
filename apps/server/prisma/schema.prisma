generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  openId    String?  @unique
  unionId   String?  @unique
  phone     String?  @unique
  nickname  String?
  avatar    String?
  role      Role     @default(PARENT)
  parentId  String?
  parent    User?    @relation("Children", fields: [parentId], references: [id])
  children  User[]   @relation("Children")
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningRecords LearningRecord[]
  dailyReports    DailyReport[]
}

enum Role {
  PARENT
  CHILD
}

model Level {
  id          String   @id @default(cuid())
  module      String
  ageGroup    String
  stage       String
  title       String
  description String
  order       Int
  content     Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningRecords LearningRecord[]
}

model LearningRecord {
  id        String   @id @default(cuid())
  childId   String
  child     User     @relation(fields: [childId], references: [id])
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id])
  correct   Boolean
  timeSpent Int
  answer    String?
  emotion   String?
  createdAt DateTime @default(now())
}

model DailyReport {
  id              String   @id @default(cuid())
  childId         String
  child           User     @relation(fields: [childId], references: [id])
  date            DateTime
  totalTime       Int
  levelsCompleted Int
  correctRate     Float
  emotionSummary  String?
  tips            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([childId, date])
}
